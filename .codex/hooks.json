{
  "description": "Run the repository validation gate before Codex stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_stop_validation.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; & py -3 (Join-Path $root 'scripts/codex_stop_validation.py')\"",
            "timeout": 600,
            "statusMessage": "Running repository validation"
          }
        ]
      }
    ]
  }
}
