{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_stop_validation.py\"",
            "commandWindows": "py -3 (Join-Path (git rev-parse --show-toplevel) 'scripts/codex_stop_validation.py')",
            "timeout": 330,
            "statusMessage": "Running changed tests"
          }
        ]
      }
    ]
  }
}
